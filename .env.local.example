# Copy this to .env.local (git-ignored) and fill in real values.
# See README.md's "Phase 2 setup" section for exactly where each of these
# comes from.

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — NEVER prefix this with NEXT_PUBLIC_, it must stay
# server-only. Used exclusively by the Stripe webhook to write another
# user's profile row (a webhook has no user session to act as).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe dashboard → Developers → API keys (test mode to start)
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Product catalog → the two Price IDs (not Product IDs) you create
STRIPE_PRICE_PLUS_ONE_TIME=
STRIPE_PRICE_PRO_ANNUAL=

# Used as a fallback for Stripe redirect URLs if the request has no Origin
# header (some server-to-server calls). Your production domain.
NEXT_PUBLIC_SITE_URL=https://therealbirdscore.com
